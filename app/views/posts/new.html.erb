<% content_for(:title) { "Новое объявление — #{@district.name}" } %>

<div class="max-w-2xl mx-auto">
  
  <div class="flex items-center gap-3 mb-6">
    <%= link_to district_path(@district.slug), class: "btn btn-ghost btn-circle" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <h1 class="text-xl font-bold">Новое объявление</h1>
  </div>

  <%= render "form", 
      post: @post,
      url: district_posts_path(@district.slug),
      method: :post,
      submit_text: "Опубликовать" %>

</div>