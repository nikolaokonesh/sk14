<% content_for(:title) { "Как вас зовут?" } %>

<div class="max-w-md mx-auto mt-12 px-4">
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold mb-2">👋 Как вас зовут?</h1>
    <p class="text-base-content/70">
      Представьтесь, чтобы другие знали, с кем общаются
    </p>
  </div>

  <%= form_with model: @user, url: auth_name_path, method: :patch, local: true, class: "space-y-4" do |f| %>
    
    <% if @user.errors.any? %>
      <div class="bg-error/10 border border-error/30 rounded-lg p-4 mb-4">
        <ul class="list-disc list-inside text-sm text-error">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.text_field :name, 
          class: "input input-bordered w-full text-lg",
          placeholder: "Иван Иванов",
          autofocus: true,
          required: true,
          maxlength: 30,
          autocomplete: "given-name" %>
      <% if @user.errors[:name].any? %>
        <label class="label">
          <span class="label-text-alt text-error font-medium"> 
            <%= @user.errors[:name].join(", ") %> 
          </span>
        </label>
      <% end %>
    </div>

    <%= f.submit "Продолжить", class: "btn btn-primary w-full btn-lg" %>
  <% end %>
</div>